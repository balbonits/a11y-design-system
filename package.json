{
  "name": "ember-ui",
  "version": "0.2.2",
  "private": true,
  "description": "Ember UI: a small, accessible React design system starter by John Dilig.",
  "type": "module",
  "license": "MIT",
  "author": "John Dilig",
  "repository": {
    "type": "git",
    "url": "https://github.com/balbonits/a11y-design-system.git"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "npm run build:lib && tsc --noEmit && storybook build -o storybook-static --quiet",
    "tokens": "node scripts/tokens-json.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:a11y": "node scripts/a11y.mjs",
    "test:mobile": "node scripts/mobile.mjs",
    "build:lib": "npm run tokens && vite build -c vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "prepare": "npm run build:lib"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^8.6.19",
    "@storybook/addon-docs": "^8.6.19",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react-vite": "^8.6.19",
    "@storybook/test": "^8.6.19",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "http-server": "^14.1.1",
    "jsdom": "^31.0.0",
    "playwright-core": "^1.65.0",
    "storybook": "^8.6.19",
    "storybook-addon-pseudo-states": "^4.0.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^3.2.7"
  },
  "files": [
    "dist",
    "src/tokens.json",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/ember.css",
    "./tokens.json": "./src/tokens.json",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
