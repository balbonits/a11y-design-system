 "semantic_shape": {
  "editorial": {
   "--font-display": "var(--font-serif)",
   "--font-body": "var(--font-sans)",
   "--weight-display": "400",
   "--radius-surface": "28px",
   "--radius-control": "9999px",
   "--radius-field": "14px",
   "--border-width": "1px",
   "--shadow-1": "0 1px 3px rgb(0 0 0 / .08)",
   "--shadow-2": "0 1px 2px rgb(0 0 0 / .05), 0 18px 40px -12px rgb(0 0 0 / .16)",
   "--shadow-press": "none",
   "--blur-glass": "14px",
   "--duration-fast": "120ms",
   "--duration-base": "220ms",
   "--duration-slow": "420ms",
   "--duration-reveal": "720ms",
   "--ease-standard": "cubic-bezier(.22,1,.36,1)",
   "--ease-press": "cubic-bezier(.3,0,.5,1)",
   "--duration-ticker": "28s",
   "--parallax-scale": "1",
   "--lift": "-2px"
  },
  "bold": {
   "--font-display": "var(--font-sans)",
   "--font-body": "var(--font-sans)",
   "--weight-display": "800",
   "--radius-surface": "22px",
   "--radius-control": "12px",
   "--radius-field": "12px",
   "--border-width": "1px",
   "--shadow-1": "0 0 0 1px var(--border-subtle)",
   "--shadow-2": "0 0 0 1px var(--border-subtle), 0 24px 60px -20px rgb(0 0 0 / .55)",
   "--shadow-press": "0 8px 30px -6px color-mix(in srgb, var(--accent) 55%, transparent)",
   "--blur-glass": "16px",
   "--duration-fast": "100ms",
   "--duration-base": "180ms",
   "--duration-slow": "360ms",
   "--duration-reveal": "640ms",
   "--ease-standard": "cubic-bezier(.16,1,.3,1)",
   "--ease-press": "cubic-bezier(.4,0,.2,1)",
   "--duration-ticker": "22s",
   "--parallax-scale": "1.4",
   "--lift": "-3px"
  },
  "tactile": {
   "--font-display": "var(--font-grotesque)",
   "--font-body": "var(--font-grotesque)",
   "--weight-display": "800",
   "--radius-surface": "20px",
   "--radius-control": "14px",
   "--radius-field": "12px",
   "--border-width": "2px",
   "--shadow-1": "2px 2px 0 var(--border)",
   "--shadow-2": "4px 4px 0 var(--border)",
   "--shadow-press": "3px 3px 0 var(--border)",
   "--blur-glass": "10px",
   "--duration-fast": "90ms",
   "--duration-base": "200ms",
   "--duration-slow": "380ms",
   "--duration-reveal": "600ms",
   "--ease-standard": "cubic-bezier(.34,1.56,.64,1)",
   "--ease-press": "cubic-bezier(.5,0,.5,1)",
   "--duration-ticker": "28s",
   "--parallax-scale": ".8",
   "--lift": "-2px"
  }
 },
 "components": {
  "button-radius": "var(--radius-control)",
  "button-border-width": "var(--border-width)",
  "button-shadow": "var(--shadow-press)",
  "button-bg": "var(--accent)",
  "button-fg": "var(--accent-contrast)",
  "button-bg-hover": "var(--accent-hover)",
  "button-lift": "var(--lift)",
  "button-duration": "var(--duration-base)",
  "button-press-duration": "var(--duration-fast)",
  "button-ease": "var(--ease-standard)",
  "button-press-ease": "var(--ease-press)",
  "field-radius": "var(--radius-field)",
  "field-border": "var(--border-width) solid var(--border)",
  "field-bg": "var(--surface)",
  "field-fg": "var(--text)",
  "card-radius": "var(--radius-surface)",
  "card-bg": "var(--surface)",
  "card-shadow": "var(--shadow-2)",
  "card-border": "var(--border-width) solid var(--border-subtle)",
  "modal-radius": "var(--radius-surface)",
  "modal-shadow": "var(--shadow-2)",
  "modal-backdrop": "color-mix(in srgb, var(--text) 45%, transparent)",
  "tabs-radius": "var(--radius-control)",
  "tabs-track": "var(--surface-muted)",
  "tabs-active-bg": "var(--surface)",
  "toast-radius": "var(--radius-field)",
  "toast-bg": "var(--text)",
  "toast-fg": "var(--color-bg)",
  "table-border": "1px solid var(--border-subtle)",
  "table-head-bg": "var(--surface-muted)",
  "focus-ring": "3px solid var(--focus)",
  "focus-offset": "2px",
  "ticker-duration": "var(--duration-ticker)",
  "reveal-duration": "var(--duration-reveal)",
  "reveal-ease": "var(--ease-standard)"
 }
